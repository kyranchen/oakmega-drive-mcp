# ---------------------------------------------------------------------------
# Copy to server/.env for local dev. On Cloud Run these are set as env vars,
# with GOOGLE_CLIENT_SECRET sourced from Secret Manager rather than plaintext.
# ---------------------------------------------------------------------------

# --- Google OAuth client (Web application type) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Public origin of THIS server ---
# Must exactly match the scheme+host you register as an authorised redirect URI.
# Local:  http://localhost:8080
# Deployed: https://<service>-<hash>-<region>.a.run.app
PUBLIC_BASE_URL=http://localhost:8080

# --- Drive ---
# The folder the plugin is allowed to read. Every listing is rooted here and
# every read is validated against it, so the server cannot be used to fetch
# arbitrary files from the user's Drive.
DRIVE_FOLDER_ID=1AU6ZW-3NFxme6388YPe98bGWWh9q_E5Y

# --- Token storage ---
# "firestore" for deployed, "memory" for local dev (non-persistent).
TOKEN_STORE_BACKEND=memory
GCP_PROJECT_ID=oakmega-take-home
FIRESTORE_DATABASE=

# --- Server ---
# Cloud Run injects PORT; don't hardcode it in the Dockerfile CMD.
PORT=8080
LOG_LEVEL=INFO
